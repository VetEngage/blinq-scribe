# Blinq Scribe settings. Copy to .env (git-ignored) and fill in only what you need.
#
# Demo mode is the default: with this file untouched, every feature runs on the synthetic
# clinic with mock AI. Add your own model keys below to use the real models.
# The rest of the app stays on demo data.
#
# Put each comment on its own line, and quote a value that contains " #".

# ===== Your model keys (optional) =====

# Meta Model API key. One key turns on Muse Spark (notes, briefs, Ask Blinq, photo reading)
# and Muse Voice Transcribe (recording). Empty = mock AI.
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.1

# Speech to text: meta | mock | openai_compatible
# Blank = meta (Muse Voice Transcribe) when MODEL_API_KEY is set, otherwise mock.
# Mock plays the sample visit into the transcript as you record.
STT_PROVIDER=
STT_BASE_URL=https://api.meta.ai/v1
# Falls back to MODEL_API_KEY
STT_API_KEY=
# Blank = muse-voice-transcribe-1.0 for meta. Required for openai_compatible.
STT_MODEL=

# SAM 3.1 segmentation. Set SAM_ENDPOINT=https://api.meta.ai/v1 to go live.
# Empty = mock outline. SAM_API_KEY falls back to MODEL_API_KEY.
SAM_ENDPOINT=
SAM_API_KEY=
SAM_MODEL=sam-3.1

# ===== Everything below runs on demo data. Leave it as is for the demo. =====

# Practice data: mock is the built-in demo PIMS (a synthetic clinic). A clinic's PIMS
# connector plugs in through server/blinqscribe/adapters/base.py (PracticeAdapter).
PRACTICE_ADAPTER=mock
BOOKING_URL_TEMPLATE=https://example.com/book?location={location_id}&service={service_id}&start={start}

# Owner texts: preview | off | demo
# preview (default): nothing is sent; the vet sees the exact text the owner would get.
# demo: every approved message goes to DEMO_SMS_TO only, through Telnyx.
SMS_MODE=preview
TELNYX_API_KEY=
# Your Telnyx number, like +15551234567
TELNYX_FROM_NUMBER=
# Optional
TELNYX_MESSAGING_PROFILE_ID=
# The one phone that receives demo texts, like +15557654321
DEMO_SMS_TO=
# The one inbox that gets demo emails (letters to specialists and owners). Blank = demo
# mode shows the email instead of sending it.
DEMO_EMAIL_TO=

# Admin and service key (glasses app, scripts). Setting it, or inviting the first person,
# turns sign in on. With neither, the console runs as an open demo.
BLINQ_SCRIBE_API_TOKEN=
# Where people open the console, used in invite links (e.g. https://scribe.example.com).
# Empty = the address the admin used.
BLINQ_SCRIBE_PUBLIC_URL=

# ===== Sign in options (optional). Blank = the button is hidden. =====
# Forgot password and Continue with Google/Microsoft also need BLINQ_SCRIBE_PUBLIC_URL:
# emailed links and OAuth redirects use only that address, never the request's host.

# Continue with Google: an OAuth client (type "Web application") in Google Cloud.
# Authorized redirect URI: <BLINQ_SCRIBE_PUBLIC_URL>/api/auth/oauth/google/callback
GOOGLE_SIGN_IN_CLIENT_ID=
GOOGLE_SIGN_IN_SECRET=
# Optional: only Google Workspace accounts from these domains, like clinic.com,clinic.org
GOOGLE_SIGN_IN_DOMAINS=
# Continue with Microsoft: an app registration in Microsoft Entra ID.
# Redirect URI (Web): <BLINQ_SCRIBE_PUBLIC_URL>/api/auth/oauth/microsoft/callback
MICROSOFT_SIGN_IN_CLIENT_ID=
MICROSOFT_SIGN_IN_SECRET=
# The practice's Microsoft tenant id: only accounts from that organization can sign in.
# Blank = "common" (any Microsoft account whose email domain Microsoft has verified).
MICROSOFT_SIGN_IN_TENANT=

# Email for password reset links and 2FA codes. Blank host = emails are only written
# to the server log. Demo mode always logs 2FA codes instead of sending them.
EMAIL_SMTP_HOST=
# Blank = 587
EMAIL_SMTP_PORT=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
# starttls | ssl | none. Blank = starttls
EMAIL_SMTP_SECURITY=
# Like "Blinq Scribe <scribe@yourclinic.com>"
EMAIL_FROM=
DATA_DIR=./var
# The clinic's time zone, like America/Chicago: the days and times on every screen. Blank = this
# server's own. Set it when the server runs in another zone (a container is UTC).
CLINIC_TZ=

# ===== Storage and background work (optional) =====
# Blank = SQLite in DATA_DIR and background work inside the server: the demo needs
# neither. `docker compose up` sets both for you.
# PostgreSQL, like postgresql://blinq:blinq@localhost:5432/blinq_scribe
DATABASE_URL=
# Temporal server, like localhost:7233. Then also run `uv run python -m blinqscribe.worker`.
TEMPORAL_ADDRESS=

# ===== Read aloud (optional) =====
# Blank = Kokoro, a natural voice on this server, once its files are downloaded
# (`cd server && uv run python -m blinqscribe.speech download`, about 95 MB);
# until then the browser's voice. browser = always the browser's voice.
TTS_PROVIDER=
# af_heart, af_bella, am_michael, am_fenrir (US); bf_emma, bm_george (UK)
TTS_VOICE=af_heart
# Where the Kokoro files go. Blank = server/var/models
MODELS_DIR=
