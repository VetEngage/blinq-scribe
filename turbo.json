{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "scripts/**", "index.html", "public/**", "schema.graphql", "package.json", "tsconfig*.json", "vite.config.ts"],
      "outputs": ["dist/**", "css/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "scripts/**", "e2e/**", "tsconfig*.json"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "css/**", "eslint/**", "package.json", "vite.config.ts", "vitest.config.ts"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
