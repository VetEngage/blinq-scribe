# Types for the parts of peewee-async this server uses (the package ships none).
from collections.abc import Iterator
from contextlib import contextmanager
from typing import Any

import peewee

class AioDatabase(peewee.Database):
    def set_allow_sync(self, value: bool) -> None: ...
    @contextmanager
    def allow_sync(self) -> Iterator[None]: ...
    async def aio_execute(self, query: Any, fetch_results: Any = None) -> Any: ...
    async def aio_close(self) -> None: ...

class PostgresqlDatabase(AioDatabase, peewee.PostgresqlDatabase): ...
class SqliteDatabase(AioDatabase, peewee.SqliteDatabase): ...

class AioModel(peewee.Model):
    @classmethod
    async def aio_get_or_none(cls, *query: Any, **filters: Any) -> Any: ...
